<%- include('partials/header') %>

<section class="page-head">
  <div class="container">
    <p class="breadcrumb"><a href="/">Trang chủ</a> / <span>Giỏ hàng</span></p>
    <h1>Giỏ hàng của bạn</h1>
  </div>
</section>

<section class="section">
  <div class="container">
    <div id="cart-empty" class="cart-empty" style="display:none;">
      <svg viewBox="0 0 120 120" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <circle cx="60" cy="60" r="44" fill="#e4e7d9"/>
        <circle cx="46" cy="50" r="8" fill="#cf8a2e" opacity="0.6"/>
        <circle cx="76" cy="68" r="10" fill="#8c3a4d" opacity="0.5"/>
        <circle cx="70" cy="42" r="5" fill="#a8c256"/>
      </svg>
      <h2>Giỏ hàng đang trống</h2>
      <p class="lede center">Hãy chọn sản phẩm phù hợp với nhu cầu của bạn, chúng tôi sẽ giữ chỗ ở đây.</p>
      <a href="/san-pham" class="btn btn--primary" style="margin-top: var(--space-3);">Xem sản phẩm</a>
    </div>

    <div id="cart-filled" class="cart-layout" style="display:none;">
      <div>
        <div id="cart-rows"></div>
      </div>
      <aside class="cart-summary">
        <h3 class="mt-0">Tóm tắt đơn hàng</h3>
        <div class="summary-row"><span>Tạm tính</span><span id="sum-subtotal">0₫</span></div>
        <div class="summary-row"><span>Phí vận chuyển</span><span id="sum-shipping">0₫</span></div>
        <p style="font-size: var(--fs-300); color: var(--ink-soft);">Miễn phí vận chuyển cho đơn từ 300.000₫</p>
        <div class="summary-row summary-row--total"><span>Tổng cộng</span><span id="sum-total">0₫</span></div>
        <button type="button" id="checkout-zalo-btn" class="btn btn--primary btn--block" data-zalo="<%= site.zalo %>" style="margin-top: var(--space-3); flex-direction: column; gap: 0.2em; line-height: 1.3;">
          <span style="display:inline-flex; align-items:center; gap:0.6em;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.48 2 2 6.03 2 11c0 2.83 1.44 5.36 3.7 7.03-.12.98-.46 2.3-1.3 3.47 1.6-.2 3.14-.9 4.33-1.78 1.02.3 2.12.46 3.27.46 5.52 0 10-4.03 10-9S17.52 2 12 2z"/></svg>
            Đặt hàng qua Zalo
          </span>
          <span style="font-size: var(--fs-300); font-weight: 600;">0869.688.384</span>
        </button>
        <p style="font-size: var(--fs-300); color: var(--ink-soft); margin-top: var(--space-2);">Bấm để mở Zalo nhắn tin cho MENOVA — nội dung đơn hàng đã được soạn sẵn, bạn chỉ cần dán và gửi.</p>

        <div id="zalo-message-panel" style="display:none; margin-top: var(--space-3);">
          <div class="form-status form-status--success">Đã mở Zalo và sao chép nội dung đơn hàng. Nếu khung chat chưa tự dán, bạn có thể dán (Ctrl+V) hoặc copy lại nội dung bên dưới.</div>
          <textarea id="zalo-message-text" class="zalo-message-text" rows="6" readonly></textarea>
          <button type="button" id="zalo-copy-again" class="btn btn--outline btn--sm" style="margin-top: var(--space-2);">Sao chép lại nội dung</button>
        </div>
      </aside>
    </div>
  </div>
</section>

<script src="/js/cart-page.js"></script>
<%- include('partials/footer') %>
