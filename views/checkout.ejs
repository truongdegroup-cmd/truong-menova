<%- include('partials/header') %>

<section class="page-head">
  <div class="container">
    <p class="breadcrumb"><a href="/">Trang chủ</a> / <a href="/gio-hang">Giỏ hàng</a> / <span>Thanh toán</span></p>
    <h1>Hoàn tất đơn hàng</h1>
  </div>
</section>

<section class="section">
  <div class="container">
    <div id="checkout-empty" style="display:none;" class="cart-empty">
      <h2>Chưa có sản phẩm để thanh toán</h2>
      <p class="lede center">Giỏ hàng của bạn đang trống. Hãy chọn sản phẩm trước khi thanh toán.</p>
      <a href="/san-pham" class="btn btn--primary" style="margin-top: var(--space-3);">Xem sản phẩm</a>
    </div>

    <form id="checkout-form" class="checkout-layout" style="display:none;">
      <div>
        <div id="form-status"></div>

        <h3 class="mt-0">Thông tin giao hàng</h3>
        <div class="form-row form-row--2">
          <div class="form-field">
            <label for="customerName">Họ và tên</label>
            <input type="text" id="customerName" name="customerName" required autocomplete="name" />
          </div>
          <div class="form-field">
            <label for="phone">Số điện thoại</label>
            <input type="tel" id="phone" name="phone" required autocomplete="tel" />
          </div>
        </div>
        <div class="form-field">
          <label for="email">Email (không bắt buộc)</label>
          <input type="email" id="email" name="email" autocomplete="email" />
        </div>
        <div class="form-field">
          <label for="address">Địa chỉ giao hàng</label>
          <textarea id="address" name="address" rows="3" required autocomplete="street-address"></textarea>
        </div>
        <div class="form-field">
          <label for="note">Ghi chú (không bắt buộc)</label>
          <textarea id="note" name="note" rows="2"></textarea>
        </div>

        <h3>Phương thức thanh toán</h3>
        <div class="payment-options">
          <label class="payment-option">
            <input type="radio" name="paymentMethod" value="cod" checked />
            <span>
              <span class="payment-option__label" style="display:block;">Thanh toán khi nhận hàng (COD)</span>
              <span class="payment-option__hint">Trả tiền mặt cho nhân viên giao hàng</span>
            </span>
          </label>
          <label class="payment-option">
            <input type="radio" name="paymentMethod" value="vnpay" />
            <span>
              <span class="payment-option__label" style="display:block;">Thanh toán qua VNPay</span>
              <span class="payment-option__hint">ATM nội địa, Visa/Master, QR code</span>
            </span>
          </label>
          <label class="payment-option">
            <input type="radio" name="paymentMethod" value="momo" />
            <span>
              <span class="payment-option__label" style="display:block;">Thanh toán qua Momo</span>
              <span class="payment-option__hint">Ví điện tử Momo</span>
            </span>
          </label>
        </div>
      </div>

      <aside class="cart-summary">
        <h3 class="mt-0">Đơn hàng của bạn</h3>
        <div id="checkout-items"></div>
        <div class="summary-row"><span>Tạm tính</span><span id="co-subtotal">0₫</span></div>
        <div class="summary-row"><span>Phí vận chuyển</span><span id="co-shipping">0₫</span></div>
        <div class="summary-row summary-row--total"><span>Tổng cộng</span><span id="co-total">0₫</span></div>
        <button type="submit" class="btn btn--primary btn--block" id="submit-order" style="margin-top: var(--space-3);">Đặt hàng</button>
      </aside>
    </form>
  </div>
</section>

<script src="/js/checkout.js"></script>
<%- include('partials/footer') %>
